# Copy to .env.local. Nothing here is secret; .env.local is gitignored anyway.

# Any Base RPC. Point it at a local anvil fork to use the seeded demo makers:
#   anvil --fork-url https://mainnet.base.org
RPC_URL=http://127.0.0.1:8545

# Aquifer, deployed to Subgraph Studio. Leave unset and the router falls back to
# paging eth_getLogs — everything still works, the maker book is just shallower
# and /api/coverage is unavailable, since totalling a maker's commitments across
# strategies is the one thing only an index can do.
GRAPH_URL=https://api.studio.thegraph.com/query/1758723/aquifer/v0.0.3

# Optional. When a Lens is deployed on the chain RPC_URL points at, /api/coverage
# recomputes every ratio on-chain and reports whether the two agree.
# LENS_ADDRESS=0x...

# Optional. Defaults to the mined address the Foundry scripts deploy Tap to.
# HOOK_ADDRESS=0x4444000000000000000000000000000000000088
